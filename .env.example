NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only (no NEXT_PUBLIC_ prefix -- never shipped to the client bundle).
# Used by src/app/api/share-target/route.ts to write into `saves` on behalf
# of the single user without a browser session (DECISIONS.md D-009).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
NOTED_USER_ID=YOUR-AUTH-USERS-UUID
